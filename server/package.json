{
  "name": "password-manager-server",
  "version": "1.0.0",
  "description": "Self-hosted password manager server",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "npx sequelize-cli db:migrate --config src/config/database.js",
    "seed": "npx sequelize-cli db:seed:all --config src/config/database.js",
    "build": "npm run migrate",
    "sequelize": "npx sequelize-cli"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "crypto-js": "^4.1.1",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^6.0.1",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.11.0",
    "sequelize": "^6.32.1",
    "sequelize-cli": "^6.6.0",
    "speakeasy": "^2.0.0",
    "url-parse": "^1.5.10",
    "uuid": "^9.0.0",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.20"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
